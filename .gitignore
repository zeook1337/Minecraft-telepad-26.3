# Gradle caches and build output. Keep the wrapper for reproducible builds.
.gradle/
build/
out/
bin/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.zip
*.7z
*.rar
src/generated/**/.cache/

# Minecraft development instances, worlds and local server settings.
/run/
/run-data/
/runs/
/saves/
/world/
/world_nether/
/world_the_end/
/config/
/serverconfig/
/crash-reports/
/screenshots/
/backups/
/server.properties
/eula.txt
/usercache.json
/usernamecache.json
/whitelist.json
/ops.json
/banned-players.json
/banned-ips.json
/servers.dat
/servers.dat_old
/options.txt

# Local logs and acceptance evidence can contain paths and player data.
logs/
*.log
*.log.*
/docs/evidence/
hs_err_pid*
replay_pid*
*.hprof
*.jfr

# Local credentials and signing keys. Do not put secrets in source files.
.env
.env.*
!.env.example
!.env.sample
*.local.properties
credentials.json
secrets.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Editor and operating-system state.
.idea/
.vscode/
*.ipr
*.iws
*.iml
.settings/
.metadata/
.classpath
.project
*.launch
/eclipse/
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
*.bak
*.tmp

# Local tooling and assistant context, if copied into this standalone project.
/.tools/
/.agents/
/.codex/

# Unmodified Forge MDK notes; the mod changelog is CHANGELOG.md.
/forge_README.txt
/forge*changelog.txt
/changelog.txt
